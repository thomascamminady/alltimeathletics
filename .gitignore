# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local scrape cache
.cache/

# Rendered site (built in CI)
site/

# Per-event JSON is derived from the parquet at site-render time.
# Keeping it out of git means a weekly data refresh diff is ~5 MB of parquet,
# not ~80 MB of JSON.
data/events/
.claude

# Local plotting scratch (one-off WR experiments; the maintained script is scripts/plot.py)
data/*.png
data/*.sh
data/wr_plot.py
data/mmaraok_wr.csv
